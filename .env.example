# ── App ──────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Dedicated CryptoPOS Database ─────────────
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=cryptopos
DB_PASSWORD=cryptopos_password
DB_NAME=crypto_pos

# ── JWT ──────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-me-in-production
JWT_EXPIRES_IN=24h

# ── Ethereum ─────────────────────────────────
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ETH_API_KEY=YOUR_ETHERSCAN_API_KEY
ETH_NETWORK_ID=1

# ── Bitcoin ──────────────────────────────────
BTC_API_URL=https://blockstream.info/api
BTC_NETWORK=mainnet

# ── Payment Settings ─────────────────────────
PAYMENT_TIMEOUT_MINUTES=15
ETH_CONFIRMATIONS=2
BTC_CONFIRMATIONS=1
SLIPPAGE_PERCENT=1.0

# ── CORS ─────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3001,http://localhost:19006

# ── Pricing ──────────────────────────────────
PRICE_REFRESH_MS=30000

# ── Optional: Sentry ─────────────────────────
# SENTRY_DSN=

# ── Optional: AWS ────────────────────────────
# AWS_REGION=ap-southeast-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=